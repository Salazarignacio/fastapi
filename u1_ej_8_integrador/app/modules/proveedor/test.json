    {
      "name": "POST /productos/  ·  Alta",
      "item": [
        {
          "name": "1. Crear producto válido  → 201 Created",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos/",
              "host": [
                "{{baseUrl}}/productos/"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Silla Ergonómica {{$timestamp}}\",\n  \"categoria\": \"MUE-01\",\n  \"precio\": 250.00,\n  \"stock\": 10,\n  \"stock_minimo\": 5,\n  \"activo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"crearSilla_id\", b.id);",
                  "pm.collectionVariables.set(\"crearSilla_nombre\", b.nombre);"
                ]
              }
            }
          ]
        },
